{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiagentcoordinationprotocol.io/schemas/macp-mcp/gate.schema.json",
  "title": "macp-mcp gate policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "server", "rules"],
  "properties": {
    "version": { "const": 1 },
    "server": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "mode", "participants"],
        "properties": {
          "tool": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["macp.mode.quorum.v1", "macp.mode.decision.v1"] },
          "participants": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "threshold": { "type": "integer", "minimum": 1 },
          "ttl_ms": { "type": "integer", "minimum": 1 },
          "policy_version": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
